    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performe AI uses the camera to photograph the meal you want to log, the plan you want to import, or the body photos you choose to send during sign-up."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Performe AI usa a câmera para fotografar a refeição que você quer registrar, o plano que você quer importar ou as fotos do corpo que você escolher enviar no cadastro."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Performe AI uses the microphone to record the description of the meal you want to log."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Performe AI usa o microfone para gravar a descrição da refeição que você quer registrar."
          }
        }
      }
    }
