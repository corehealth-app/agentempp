      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pergunte sobre seus dados, metas e progresso. O Flow é uma IA e não substitui orientação profissional." } }
    } },
    "tour.flow.body.suggestions" : { "localizations" : {
      "en" : { "stringUnit" : { "state" : "translated", "value" : "Ask about your data and request workout or meal plan suggestions. They only count after you review and confirm them." } },
      "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Pergunte sobre seus dados e peça sugestões de treino ou cardápio. Elas só valem depois que você revisar e confirmar." } }
